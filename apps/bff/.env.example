NODE_ENV=production
PORT=3100
PUBLIC_ORIGIN=https://mms.example.com
TRUST_PROXY_HOPS=1
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
REDIS_URL=rediss://mms-bff:replace-me@redis.internal:6379
OIDC_ISSUER=https://identity.example.com/
OIDC_CLIENT_ID=mms-bff
OIDC_CLIENT_SECRET=replace-me
OIDC_REDIRECT_URI=https://mms.example.com/auth/callback
OIDC_EMPLOYEE_ID_CLAIM=employee_id
BFF_ASSERTION_PRIVATE_KEY_PATH=/run/secrets/mms-bff-private-key
VENDOR_API_URL=http://vendor-management:3001
INVENTORY_API_URL=http://inventory:3002
PROCUREMENT_API_URL=http://procurement:3003
RECEIVING_API_URL=http://receiving:3004
WAREHOUSE_API_URL=http://warehouse-operations:3005
RETAIL_SALES_API_URL=http://retail-sales:3006
SALES_AUDIT_API_URL=http://sales-audit:3007
FINANCIALS_API_URL=http://financials:3008
